# Local SQLite. Keep this file and its WAL files on persistent storage.
DATABASE_PATH=data/dropthatuni.sqlite

# Required for a production build's runtime; localhost is inferred in development.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# Same R2 endpoint/key variables as DropThatClass. Use a PRIVATE documents bucket.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME_DOCUMENTS=

# Set to the public HTTPS URL in Coolify (leave unset in local development).
# ORIGIN=https://your-domain


# Deadline reminder delivery (Resend sending API key and verified sender).
RESEND_API_KEY=
REMINDER_FROM_EMAIL=DropThatUni <reminders@your-domain>
# Generate a separate random secret; protects the optional external cron endpoint.
REMINDER_CRON_SECRET=
# true: check every 5 minutes inside this persistent app process.
# false/unset: schedule POST /api/reminders/run using n8n/cron instead.
REMINDER_AUTO_RUN=false

# Production request limit supports 10 MB document uploads and 2 MB workspace imports.
BODY_SIZE_LIMIT=12M

# Coolify proxy only: do not publish a host port that bypasses the proxy.
# Increase XFF_DEPTH if additional trusted proxies append addresses.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
